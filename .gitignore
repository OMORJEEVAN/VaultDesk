# ============================================================
# VaultDesk – .gitignore
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build & Packaging outputs
out/
dist/
release/
build/

# Local databases & user data (NEVER commit vault credentials!)
*.db
*.db-journal
*.db-wal
*.db.tmp
vaultdesk.db
vault_data/
test_vault_data/
tests/test_vault_data/
settings.json

# Test & coverage
coverage/
*.lcov
.vitest/

# Vite build cache
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary archives
*.zip
*.tar.gz
*.7z
*.rar

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDEs and Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
